# ==============================================================================
# Configuration « Sherlock AI » — copiez ce fichier en `.env` et renseignez-le.
# Toutes les informations de licence (clés d'API) sont centralisées ici :
# vous n'avez à les saisir qu'une seule fois.
# ==============================================================================

# ----- Open WebUI (interface enquêteur) --------------------------------------
# Secret de session : mettez une longue chaîne aléatoire.
WEBUI_SECRET_KEY=changez-moi-avec-une-chaine-aleatoire-longue
WEBUI_NAME=Sherlock AI
# Port d'accès à l'interface (http://localhost:3000 par défaut).
OPENWEBUI_PORT=3000

# ----- Providers LLM pour l'interface (agnostique) ---------------------------
# Plusieurs providers compatibles OpenAI, séparés par un point-virgule ';'.
# Les deux listes doivent être alignées (même ordre).
#
# Exemples d'URLs compatibles OpenAI :
#   OpenAI    : https://api.openai.com/v1
#   Gemini    : https://generativelanguage.googleapis.com/v1beta/openai
#   Anthropic : https://api.anthropic.com/v1        (mode compatibilité OpenAI)
#
# Exemple à 3 providers :
# OPENAI_API_BASE_URLS=https://api.openai.com/v1;https://generativelanguage.googleapis.com/v1beta/openai;https://api.anthropic.com/v1
# OPENAI_API_KEYS=sk-openai-xxx;AIza-gemini-xxx;sk-ant-xxx
OPENAI_API_BASE_URLS=https://api.openai.com/v1
OPENAI_API_KEYS=sk-remplacez-par-votre-cle

# ----- Modèle par défaut ---------------------------------------------------
# Modèle présélectionné à l'ouverture d'un nouveau chat (tous les modèles du
# provider sont accessibles aux enquêteurs par défaut dans un env. fermé).
# La visibilité fine se gère dans Admin → Modèles (activer/désactiver).
# Identifiants valides (OpenAI) : gpt-4o-mini, gpt-4o, gpt-4-turbo
DEFAULT_MODELS=gpt-4o-mini

# ----- Modèles accessibles aux enquêteurs (non-admins) -----------------------
# Identifiants séparés par ';'. Le bootstrap crée des entrées de modèles publiques
# pour que les enquêteurs (rôle 'user') puissent les utiliser.
# Exemples : gpt-4o-mini;gpt-4o;gpt-4-turbo
ENABLED_MODELS=gpt-4o-mini
# Sous-ensemble de ENABLED_MODELS nécessitant reasoning_effort="none" (modèles
# reasoning type o1/o3/gpt-5.x). Ne pas y mettre gpt-4o/gpt-4o-mini : ce
# paramètre casse ces modèles (non supporté).
REASONING_MODELS=

# ----- Serveur d'outils (MCP + mcpo) -----------------------------------------
# Clé protégeant l'accès aux outils depuis Open WebUI (choisissez-en une).
MCPO_API_KEY=changez-moi-cle-outils

# Provider LLM qui « joue » les suspects (compatible OpenAI). Peut être le même
# provider que ci-dessus ou un modèle dédié (souvent moins cher / plus rapide).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-remplacez-par-votre-cle
LLM_MODEL=gpt-4o-mini

# ----- Comptes Open WebUI ----------------------------------------------------
# Compte administrateur (règle la difficulté en activant/désactivant les modèles).
ADMIN_NAME=Administrateur
ADMIN_EMAIL=admin@sherlock.local
ADMIN_PASSWORD=changez-moi-admin

# Comptes enquêteurs génériques créés automatiquement :
#   enqueteur1@sherlock.local ... enqueteurN@sherlock.local (même mot de passe).
INVESTIGATOR_COUNT=5
INVESTIGATOR_PREFIX=enqueteur
INVESTIGATOR_DOMAIN=sherlock.local
INVESTIGATOR_PASSWORD=changez-moi-enqueteur
